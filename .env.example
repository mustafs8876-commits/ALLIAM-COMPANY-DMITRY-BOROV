# Vercel > Project > Settings > Environment Variables
# Create a new bot via https://t.me/BotFather and send it /start.
TELEGRAM_BOT_TOKEN=123456789:PASTE_YOUR_BOT_TOKEN_HERE
# OPTIONAL: private-message recipient is temporarily preset as 5675498860 in api/contact.js
# Override this variable to send requests to another person/group:
TELEGRAM_CHAT_ID=5675498860

# Optional: if Telegram group has a forum topic where you want the leads
# TELEGRAM_THREAD_ID=1

# Optional but recommended: spam protection via Cloudflare Turnstile.
# Also set turnstileSiteKey (public site key) in config.js.
# TURNSTILE_SECRET_KEY=replace_with_private_turnstile_secret

# Optional: distributed rate limiting across Vercel instances (5 per IP/hour)
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_token
